{
  "name": "Weather Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://ollama:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": \"Generate a quick weather activity recommendation for outdoor sports.\",\n  \"stream\": false\n}",
        "options": {}
      },
      "id": "2",
      "name": "Query Ollama LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO weather_recommendations (city, temperature, condition, llm_recommendation) VALUES ('London', 15, 'Cloudy', '{{ $json.response.replace(/'/g, \"''\") }}');"
      },
      "id": "3",
      "name": "Store in Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [750, 300],
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{"node": "Query Ollama LLM", "type": "main", "index": 0}]]
    },
    "Query Ollama LLM": {
      "main": [[{"node": "Store in Postgres", "type": "main", "index": 0}]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
